<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_primary_dark</item>
        <!-- Bản có safe padding: Android 12 áp mask vẫn giữ trọn chữ và viền logo. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_system_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_primary_dark</item>
        <item name="android:windowSplashScreenAnimationDuration">320</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/brand_primary_dark</item>
    </style>
</resources>
